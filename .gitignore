# Dependencies
node_modules/

# Build output
/apps/web/.next/
/packages/*/dist/
*.tsbuildinfo

# Env files — never commit real secrets
.env
.env.local
.env.*.local
!.env.example

# SQLite local dev database
/apps/web/prisma/dev.db
/apps/web/prisma/dev.db-journal

# Misc
.DS_Store
*.pem
npm-debug.log*
.vercel

# Local database backups — never commit
/backups/
*.db
*.db-journal

# Prisma schema backups created during database migration
/apps/web/prisma-postgres/*.backup
/apps/web/prisma-postgres/*.pre-neon.backup

apps/web/prisma/dev.db
